# Step 1: Create OddList and EvenList based on ID conditions
OddList = [num for num in myList if num % 2 == 1]  # Odd values
EvenList = [num for num in myList if num % 2 == 0]  # Even values

print("OddList is", OddList)
print("EvenList is", EvenList)

# Step 2: Find the longer list and reverse sort it
if len(OddList) >= len(EvenList):
    longer_list, list_name = OddList, "OddList"
else:
    longer_list, list_name = EvenList, "EvenList"

longer_list_sorted = sorted(longer_list, reverse=True)
print(f"{list_name} in reverse sorted order is", longer_list_sorted)

# Step 3: Determine which list to check for most frequent value
target_list, target_name = (EvenList, "EvenList") if len(OddList) > len(EvenList) else (OddList, "OddList")

# Step 4: Find the most frequent value manually
def most_frequent(lst):
    freq_dict = {}
    max_count = 0
    most_freq_value = None

    for num in lst:
        freq_dict[num] = freq_dict.get(num, 0) + 1
        if freq_dict[num] > max_count:
            max_count = freq_dict[num]
            most_freq_value = num

    return most_freq_value

if target_list:
    most_common = most_frequent(target_list)
    print(f"The value {most_common} occurs most often in {target_name}")



